{
  "name": "xenoclipper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpusClip-style viral clip studio that runs 100% in the browser: local Whisper transcription, LLM clip curation, face-tracked 9:16 reframing and karaoke captions via FFmpeg.wasm. No backend, no uploads, no cost.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "postinstall": "node scripts/copy-ort.mjs && node scripts/copy-mediapipe.mjs && node scripts/copy-ffmpeg.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
